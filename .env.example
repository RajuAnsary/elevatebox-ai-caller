# Server
PORT=3000
NODE_ENV=development

# Vapi outbound calling
# Obtain these values from the Vapi dashboard. Do not commit real credentials.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
TARGET_PHONE_NUMBER=

# WhatsApp Cloud API. Leave WHATSAPP_PROVIDER blank (or unset) for local mock delivery.
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_RECIPIENT_NUMBER=

# Follow-up metadata and optional public HTTPS media URLs.
MY_PHONE_NUMBER=
RESUME_PATH=
ARCHITECTURE_IMAGE_PATH=

# Public base URL used to configure the Vapi server webhook.
PUBLIC_BASE_URL=https://elevatebox-ai-caller.onrender.com
